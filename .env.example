# ── Supabase (public — safe to expose in browser) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase service role (SERVER ONLY — never expose in browser!) ────────────
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# ── Neo calendar integration (SERVER ONLY) ────────────────────────────────────
# Base URL of the Neo API (e.g. https://neo.shmt.app)
NEO_API_URL=

# Shared secret for Forge → Neo requests (x-api-secret header)
# Value from Neo: see project settings / Forge integration page
NEO_FORGE_API_SECRET=

# ── Cron job security ─────────────────────────────────────────────────────────
# Vercel Cron passes this as "Authorization: Bearer <CRON_SECRET>"
# Set any random string here and the same in Vercel project environment variables
CRON_SECRET=

# ── AI Coach (SERVER ONLY — never expose in the browser) ──────────────────────
# Anthropic API key, powers /api/ai/parse and /api/ai/coach.
# Without it FORGE still works; the AI features report themselves as unavailable.
ANTHROPIC_API_KEY=
